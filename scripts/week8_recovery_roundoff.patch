diff --git a/tests/week8/test_source.py b/tests/week8/test_source.py
index e48c825..1e92625 100644
--- a/tests/week8/test_source.py
+++ b/tests/week8/test_source.py
@@ -97,9 +97,36 @@ def test_independent_rational_raw_moment_and_resolvent_identities(index, second,
     cell = full_design().cells[index]
     ph = e4.phase_type(cell)
     np.testing.assert_allclose(ph.pi @ ph.Q, np.zeros(2), atol=1e-15, rtol=0)
-    np.testing.assert_allclose(ph.P @ np.ones(2), np.ones(2), atol=1e-15, rtol=0)
-    np.testing.assert_allclose(ph.alpha @ ph.P, ph.alpha, atol=1e-15, rtol=0)
-    np.testing.assert_allclose(ph.alpha @ ph.inverse_A, .5 * ph.pi, atol=1e-15, rtol=0)
+    # These identities follow a 2x2 solve. A fixed 1e-15 absolute tolerance
+    # ignores amplification by its condition number (about 17.88 at r=20).
+    # Check the inverse and transition entries against exact rational algebra,
+    # and allow a condition-scaled floating-point budget, not a scientific gate.
+    r = int(cell.ratio)
+    lc, lb = Fraction(12, r + 5), Fraction(12*r, r + 5)
+    a, b, c, d = lc + Fraction(1, 5), -Fraction(1, 5), Fraction(-1), lb + 1
+    determinant = a*d - b*c
+    inverse = np.array([[float(d/determinant), float(-b/determinant)],
+                        [float(-c/determinant), float(a/determinant)]])
+    denom = r*r + 70*r + 25
+    transition = np.array([[float(Fraction(5*(13*r+5), denom)), float(Fraction(r*(r+5), denom))],
+                           [float(Fraction(5*(r+5), denom)), float(Fraction(r*(r+65), denom))]])
+    condition = np.linalg.cond(ph.A, np.inf)
+    assert condition < 20  # A corrupt or ill-conditioned matrix cannot inflate the budget.
+    tolerance = 8*np.finfo(float).eps*max(1., condition)
+    np.testing.assert_allclose(ph.inverse_A, inverse, rtol=0,
+                               atol=tolerance*max(1., np.linalg.norm(inverse, np.inf)))
+    np.testing.assert_allclose(ph.P, transition, rtol=0, atol=tolerance)
+    np.testing.assert_allclose(ph.P @ np.ones(2), np.ones(2), atol=2*tolerance, rtol=0)
+    np.testing.assert_allclose(ph.alpha @ ph.P, ph.alpha, atol=tolerance, rtol=0)
+    np.testing.assert_allclose(ph.alpha @ ph.inverse_A, .5 * ph.pi,
+                               atol=tolerance*max(1., np.linalg.norm(inverse, np.inf)), rtol=0)
+    # A normwise backward-residual check guards A P = Lambda. Forming P via
+    # inv(A) @ Lambda does not promise a componentwise backward-error bound:
+    # cancellation in a small entry can exceed one even for an accurate solve.
+    residual = np.linalg.norm(ph.A @ ph.P - ph.Lambda, np.inf)
+    scale = (np.linalg.norm(ph.A, np.inf)*np.linalg.norm(ph.P, np.inf)
+             + np.linalg.norm(ph.Lambda, np.inf))
+    assert residual <= 8*np.finfo(float).eps*scale
     expected = e4.moments(cell)
     assert expected["mean"] == pytest.approx(.5, abs=2e-15)
     assert expected["second_moment"] == pytest.approx(float(second), rel=2e-14)
